{
  "name": "@enneo/claude-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the Enneo platform — exposes ticket, AI agent, customer, and configuration tools using a saved profile API key.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "enneo-claude-mcp-server": "bundle/index.js"
  },
  "files": ["bundle"],
  "scripts": {
    "build": "tsc",
    "bundle": "npm run build && esbuild dist/index.js --bundle --platform=node --format=esm --target=node18 --outfile=bundle/index.js",
    "dev": "tsc --watch",
    "start": "node bundle/index.js",
    "prepare": "npm run bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "open": "^10.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
